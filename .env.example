# Copy this file to `.env` and fill in only the keys you need.
# NO key is needed for: Yahoo Finance, Binance market data, Polymarket.

# Finnhub — real-time quotes, company fundamentals, financial news.
# Free key (60 calls/min): https://finnhub.io/register
FINNHUB_API_KEY=

# Twelve Data — real-time prices & intraday time series.
# Free key (8 calls/min, 800/day): https://twelvedata.com
TWELVE_DATA_API_KEY=

# FRED — US & global economic data (St. Louis Fed).
# Free key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# NewsAPI — broad news search across outlets.
# Free developer key (100 req/day): https://newsapi.org/register
NEWSAPI_API_KEY=
